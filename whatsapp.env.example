# Copiar a .env.whatsapp. Nunca subir el archivo con valores reales.
DATABASE_URL=sqlite:///whatsapp-demo.sqlite3
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
# Versión vigente indicada por el panel de Meta, formato vNN.0.
WHATSAPP_API_VERSION=
# Reemplazar el ID ficticio por el identificador del número de prueba, no su teléfono.
WHATSAPP_PHONE_BUSINESSES={"REEMPLAZAR_PHONE_NUMBER_ID":"alfa"}
# Opcional: el mismo LLM del chat web (interpretación de reservas y RAG).
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
LLM_BASE_URL=https://api.groq.com/openai/v1
